# RetailForge AI local/demo configuration
# The app runs in demo fallback mode when DATABASE_URL is empty.
DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
VITE_APP_ID=replace-with-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://api.manus.im/oauth/authorize
OWNER_OPEN_ID=
OWNER_NAME=RetailForge Owner
NODE_ENV=development
